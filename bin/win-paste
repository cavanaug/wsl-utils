#!/bin/bash
#  ┌──────────────────────────────────────────────────────────────────────────────┐
#  │                                                                              │
#  │    ██╗    ██╗██╗███╗   ██╗      ██████╗  █████╗ ███████╗████████╗███████╗    │
#  │    ██║    ██║██║████╗  ██║      ██╔══██╗██╔══██╗██╔════╝╚══██╔══╝██╔════╝    │
#  │    ██║ █╗ ██║██║██╔██╗ ██║█████╗██████╔╝███████║███████╗   ██║   █████╗      │
#  │    ██║███╗██║██║██║╚██╗██║╚════╝██╔═══╝ ██╔══██║╚════██║   ██║   ██╔══╝      │
#  │    ╚███╔███╔╝██║██║ ╚████║      ██║     ██║  ██║███████║   ██║   ███████╗    │
#  │     ╚══╝╚══╝ ╚═╝╚═╝  ╚═══╝      ╚═╝     ╚═╝  ╚═╝╚══════╝   ╚═╝   ╚══════╝    │
#  │                                                                              │
#  └──────────────────────────────────────────────────────────────────────────────┘
#  win-paste
#  - Paste Windows clipboard to stdout (symlink as wl-paste for tool compatibility)
#  - Default: strip trailing ^M (CR). Use --raw for exact bytes.
#  - --file-url / --file-path / --file-atpath materialize to cache and emit a reference
#
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'EOF'
win-paste - Paste from Windows clipboard to stdout

USAGE:
    win-paste [OPTIONS]

DESCRIPTION:
    Retrieves content from the Windows clipboard and outputs it to stdout.
    By default strips trailing carriage return characters (^M) for Unix line endings.

    If WSLg is available and enabled, uses wl-paste with proper fallback.
    Otherwise, uses PowerShell's Get-Clipboard command.

    File materialize modes write clipboard content under
    ${XDG_CACHE_HOME:-$HOME/.cache}/wslutil/clipboard and emit a path/URL;
    with no --format, the richest available clipboard format is chosen.

OPTIONS:
    -h, --help      Show this help message and exit
    --raw           Do not alter line endings (no ^M stripping)
    --file-url      Materialize clipboard to cache; print file:// URL
    --file-path     Materialize clipboard to cache; print absolute path
    --file-atpath   Materialize clipboard to cache; print @<absolute-path>
    --format FMT    Write as png|txt|html

    When WSLg is available, all wl-paste options are supported:
    -n, --no-newline    Don't add newline at end of output (DEFAULT)
    -l, --list-types    List available MIME types
    -t, --type TYPE     Select MIME type to paste
    -p, --primary       Use primary selection (if available)
    -s, --seat SEAT     Use specific seat

EXAMPLES:
    win-paste > clipboard.txt       # Save clipboard to file
    win-paste | grep "error"        # Search clipboard content
    win-paste --raw > binary.bin    # Exact clipboard bytes
    echo "backup: $(win-paste)"     # Include clipboard in output
    win-paste --file-atpath         # Materialize; print @/path
    win-paste --file-url --format png  # Materialize as PNG; print file:// URL

NOTES:
    - Logs usage to ~/.local/state/wslutil/win-clipboard.log when WSLUTIL_DEBUG is set
    - Automatically handles Windows line endings unless --raw is used
    - Can be symlinked as wl-paste for compatibility
EOF
    exit 0
fi

WIN_WINDIR=${WIN_WINDIR:-/mnt/c/Windows}
WL_PASTE=${WL_PASTE:-/usr/bin/wl-paste}

RAW=0
FILE_MODE="" # url|path|atpath|empty
FORMAT=""
ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --raw)
            RAW=1
            shift
            ;;
        --file-url | --file-path | --file-atpath)
            if [[ -n "$FILE_MODE" ]]; then
                echo "win-paste: use only one of --file-url, --file-path, --file-atpath" >&2
                exit 1
            fi
            case "$1" in
                --file-url) FILE_MODE=url ;;
                --file-path) FILE_MODE=path ;;
                --file-atpath) FILE_MODE=atpath ;;
            esac
            shift
            ;;
        --format)
            [[ $# -ge 2 ]] || {
                echo "win-paste: --format requires a value" >&2
                exit 1
            }
            FORMAT="$2"
            shift 2
            ;;
        --format=*)
            FORMAT="${1#--format=}"
            shift
            ;;
        -h | --help)
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ -n "$FILE_MODE" && $RAW -eq 1 ]]; then
    echo "win-paste: --raw cannot be combined with --file-*" >&2
    exit 1
fi

if [[ -n "$FORMAT" && "$FORMAT" != txt && "$FORMAT" != html && "$FORMAT" != png ]]; then
    echo "win-paste: unsupported --format: $FORMAT (png|txt|html)" >&2
    exit 1
fi

powershell_bin() {
    printf '%s' "${WIN_WINDIR}/System32/WindowsPowerShell/v1.0/powershell.exe"
}

# Remote SSH (not from loopback) — WSLg clipboard is the local Windows session.
ssh_is_remote() {
    [[ -n "${SSH_CONNECTION:-}" ]] || return 1
    local client="${SSH_CONNECTION%% *}"
    [[ "$client" != "127.0.0.1" && "$client" != "::1" ]]
}

use_wlg() {
    [[ -x "$WL_PASTE" ]] || return 1
    ssh_is_remote && return 1
    # Explicit override (tests set 0; Windows Terminal usually sets 1)
    case "${WSL2_GUI_APPS_ENABLED:-}" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    # Local/no-SSH often lacks WSL2_GUI_APPS_ENABLED; probe WSLg Wayland instead
    local runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local display="${WAYLAND_DISPLAY:-wayland-0}"
    [[ -e "${runtime}/${display}" ]]
}

# --- materialize cache ---

clipboard_cache_dir() {
    local dir="${XDG_CACHE_HOME:-$HOME/.cache}/wslutil/clipboard"
    mkdir -m 700 -p "$dir"
    chmod 700 "$dir"
    printf '%s' "$dir"
}

clipboard_store() {
    local src="${1:?}" kind="${2:?}" ext="${3:?}"
    local dir shortsum existing dest
    [[ -f "$src" ]] || return 1
    dir="$(clipboard_cache_dir)"
    shortsum="$(sha256sum -- "$src" | awk '{print substr($1,1,12)}')"
    # ponytail: glob scan fine for a personal clipboard cache
    existing="$(compgen -G "$dir/clip-"*"-${kind}-${shortsum}.${ext}" || true)"
    if [[ -n "$existing" ]]; then
        printf '%s' "$(printf '%s\n' "$existing" | head -n1)"
        return 0
    fi
    dest="${dir}/clip-$(date +%Y%m%d-%H%M%S)-${kind}-${shortsum}.${ext}"
    cp -- "$src" "$dest"
    chmod 600 "$dest"
    printf '%s' "$dest"
}

clipboard_file_url() {
    local abspath="${1:?}"
    [[ "$abspath" == /* ]] || return 1
    # ponytail: no percent-encoding; cache filenames are ASCII and HOME almost always is
    printf 'file://%s' "$abspath"
}

# --- probes ---

ps_try_text() {
    local out="$1"
    "$(powershell_bin)" -NoProfile -Command \
        '[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; $t=Get-Clipboard -Raw -ErrorAction SilentlyContinue; if($null -eq $t -or $t -eq ""){ exit 1 }; [Console]::Out.Write($t)' \
        >"$out" 2>/dev/null
}

ps_try_html() {
    local out="$1"
    "$(powershell_bin)" -NoProfile -Command \
        '$h=Get-Clipboard -TextFormatType Html -ErrorAction SilentlyContinue; if($null -eq $h -or $h -eq ""){ exit 1 }; [Console]::OutputEncoding=[System.Text.Encoding]::UTF8; [Console]::Out.Write($h)' \
        >"$out" 2>/dev/null
}

ps_try_image_png() {
    local out="$1" win_out
    if command -v wslpath >/dev/null 2>&1; then
        win_out="$(wslpath -w "$out")"
    else
        win_out="$out"
    fi
    WIN_PASTE_OUT="$win_out" "$(powershell_bin)" -NoProfile -Command \
        'Add-Type -AssemblyName System.Windows.Forms; Add-Type -AssemblyName System.Drawing; $img=[Windows.Forms.Clipboard]::GetImage(); if($null -eq $img){exit 1}; $img.Save($env:WIN_PASTE_OUT,[Drawing.Imaging.ImageFormat]::Png)' \
        2>/dev/null
    [[ -s "$out" ]]
}

wl_list_types() {
    "$WL_PASTE" -l 2>/dev/null || true
}

wl_try_mime() {
    local mime="$1" out="$2"
    "$WL_PASTE" -n -t "$mime" >"$out" 2>/dev/null && [[ -s "$out" ]]
}

# BMP → PNG via ImageMagick only (magick, else convert).
wl_bmp_to_png() {
    local src="${1:?}" dest="${2:?}"
    if command -v magick >/dev/null 2>&1; then
        magick "$src" "png:$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    elif command -v convert >/dev/null 2>&1; then
        convert "$src" "png:$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    fi
    return 1
}

wl_try_bmp_as_png() {
    local types="$1" out="$2" mime bmp_tmp
    for mime in image/bmp image/x-ms-bmp; do
        if printf '%s\n' "$types" | grep -qx "$mime"; then
            bmp_tmp="$(mktemp)"
            if wl_try_mime "$mime" "$bmp_tmp" && wl_bmp_to_png "$bmp_tmp" "$out"; then
                rm -f "$bmp_tmp"
                return 0
            fi
            rm -f "$bmp_tmp"
        fi
    done
    return 1
}

# Image ladder. png_only=1 → png mime or bmp→png only. Sets KIND/EXT.
wl_try_image() {
    local types="$1" out="$2" png_only="${3:-0}" mime
    if [[ "$png_only" -eq 1 ]]; then
        if printf '%s\n' "$types" | grep -qx 'image/png' && wl_try_mime image/png "$out"; then
            KIND=image
            EXT=png
            return 0
        fi
    else
        for mime in image/png image/jpeg image/gif image/webp; do
            if printf '%s\n' "$types" | grep -qx "$mime" && wl_try_mime "$mime" "$out"; then
                KIND=image
                case "$mime" in
                    image/png) EXT=png ;;
                    image/jpeg) EXT=jpg ;;
                    image/gif) EXT=gif ;;
                    image/webp) EXT=webp ;;
                esac
                return 0
            fi
        done
    fi
    if wl_try_bmp_as_png "$types" "$out"; then
        KIND=image
        EXT=png
        return 0
    fi
    return 1
}

strip_cr_inplace() {
    sed 's/\r$//' "$1" >"${1}.out" && mv "${1}.out" "$1"
}

try_text() {
    local out="$1"
    if use_wlg; then
        wl_try_mime text/plain "$out"
    else
        ps_try_text "$out"
    fi
}

try_html() {
    local out="$1"
    if use_wlg; then
        wl_try_mime text/html "$out"
    else
        ps_try_html "$out"
    fi
}

try_png() {
    local out="$1" types
    if use_wlg; then
        types="$(wl_list_types)"
        wl_try_image "$types" "$out" 1
    else
        ps_try_image_png "$out" && KIND=image && EXT=png
    fi
}

# Sets PAYLOAD_FILE KIND EXT. format is optional (png|txt|html).
fetch_clipboard_payload() {
    local format="${1:-}" tmp types
    tmp="$(mktemp)"

    case "$format" in
        txt)
            try_text "$tmp" || {
                rm -f "$tmp"
                echo "win-paste: no text on clipboard" >&2
                return 1
            }
            strip_cr_inplace "$tmp"
            PAYLOAD_FILE="$tmp"
            KIND=text
            EXT=txt
            return 0
            ;;
        html)
            try_html "$tmp" || {
                rm -f "$tmp"
                echo "win-paste: no HTML on clipboard" >&2
                return 1
            }
            PAYLOAD_FILE="$tmp"
            KIND=html
            EXT=html
            return 0
            ;;
        png)
            try_png "$tmp" || {
                rm -f "$tmp"
                echo "win-paste: no image on clipboard" >&2
                return 1
            }
            PAYLOAD_FILE="$tmp"
            return 0
            ;;
    esac

    # richest: image → html → text
    if use_wlg; then
        types="$(wl_list_types)"
        if wl_try_image "$types" "$tmp" 0; then
            PAYLOAD_FILE="$tmp"
            return 0
        fi
        if printf '%s\n' "$types" | grep -qx 'text/html' && wl_try_mime text/html "$tmp"; then
            PAYLOAD_FILE="$tmp"
            KIND=html
            EXT=html
            return 0
        fi
        if wl_try_mime text/plain "$tmp"; then
            strip_cr_inplace "$tmp"
            PAYLOAD_FILE="$tmp"
            KIND=text
            EXT=txt
            return 0
        fi
    else
        if ps_try_image_png "$tmp"; then
            PAYLOAD_FILE="$tmp"
            KIND=image
            EXT=png
            return 0
        fi
        if ps_try_html "$tmp"; then
            PAYLOAD_FILE="$tmp"
            KIND=html
            EXT=html
            return 0
        fi
        if ps_try_text "$tmp"; then
            strip_cr_inplace "$tmp"
            PAYLOAD_FILE="$tmp"
            KIND=text
            EXT=txt
            return 0
        fi
    fi

    rm -f "$tmp"
    echo "win-paste: clipboard empty or unsupported" >&2
    return 1
}

materialize_and_emit() {
    local mode="$1" format="${2:-}" path
    fetch_clipboard_payload "$format" || return 1
    path="$(clipboard_store "$PAYLOAD_FILE" "$KIND" "$EXT")" || {
        rm -f "$PAYLOAD_FILE"
        return 1
    }
    rm -f "$PAYLOAD_FILE"
    case "$mode" in
        path) printf '%s\n' "$path" ;;
        atpath) printf '@%s\n' "$path" ;;
        url) printf '%s\n' "$(clipboard_file_url "$path")" ;;
    esac
}

if [[ -n "$FILE_MODE" ]]; then
    materialize_and_emit "$FILE_MODE" "$FORMAT"
    exit $?
fi

debug_log() {
    local backend="$1"
    shift
    local parent_cmd
    [[ -n "${WSLUTIL_DEBUG:-}" ]] || return 0
    mkdir -p "${HOME}/.local/state/wslutil"
    parent_cmd="$(ps -p "${PPID}" -o cmd= 2>/dev/null | cut -f1 -d' ' || true)"
    echo "$(date --rfc-3339=s) - ${backend} [$(basename -- "${parent_cmd}")] $(basename -- "${0}") $*" >>"${HOME}/.local/state/wslutil/win-clipboard.log"
}

paste_clipboard() {
    if use_wlg; then
        debug_log "$WL_PASTE" "$@"
        "$WL_PASTE" -n "$@"
    else
        debug_log "win-paste script" "$@"
        "$(powershell_bin)" -NoProfile -Command '[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; $OutputEncoding = [System.Text.Encoding]::UTF8; [Console]::Out.Write((Get-Clipboard -Raw).ToString())'
    fi
}

if [[ $RAW -eq 1 ]]; then
    paste_clipboard "${ARGS[@]}"
else
    paste_clipboard "${ARGS[@]}" | sed 's/\r$//'
fi
